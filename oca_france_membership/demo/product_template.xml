<odoo>
    <record id="demo_membership_product" model="product.template">
        <field name="name">OCA France Membership</field>
        <field name="membership" eval="True" />
        <field name="type">service</field>
        <field name="list_price">50</field>
        <field name="taxes_id" eval="[(5,)]" />
        <field
            name="membership_date_from"
            eval="(DateTime.today()).strftime('%Y-01-01')"
        />
        <field
            name="membership_date_to"
            eval="(DateTime.today()).strftime('%Y-12-31')"
        />
    </record>
</odoo>
