<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="partner_detail" inherit_id="website_partner.partner_detail">
        <xpath expr="//h1[@id='partner_name']/../.." position="after">
            <span
                t-if="partner.odoo_worker_qty"
                style="font-style:italic;font-weight:bold;"
            >
                    Odoo Team : <t t-out="partner.odoo_worker_qty" /> Members
                </span>
        </xpath>
    </template>
</odoo>
